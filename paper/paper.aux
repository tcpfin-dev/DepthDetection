\newlabel{fig:results}{{2}{4}{Mean absolute distance error against true object distance, all objects. Absolute error grows monotonically for every model but Marigold, while relative error grows far more slowly (Section~\ref {sec:results}), the signature of a correctly scaled depth-to-metric fit}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Two frames with Depth Anything V2 Large: a mug at 0.50~m in white light (top) and the tall clear bottle at 0.90~m under infrared (bottom). Columns are the RGB input, the relative-depth map (magma, brighter = closer) and the sized output. The mug is sized to within 1.1~cm; the bottle, which barely separates from the background in the depth map, is read 16.8~cm too far, and its width error propagates into a reported 9.1~cm width for a 6.2~cm object.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:qualitative}{{3}{4}{Two frames with Depth Anything V2 Large: a mug at 0.50~m in white light (top) and the tall clear bottle at 0.90~m under infrared (bottom). Columns are the RGB input, the relative-depth map (magma, brighter = closer) and the sized output. The mug is sized to within 1.1~cm; the bottle, which barely separates from the background in the depth map, is read 16.8~cm too far, and its width error propagates into a reported 9.1~cm width for a 6.2~cm object}{figure.3}{}}
